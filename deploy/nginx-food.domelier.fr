server {
    listen 443 ssl http2;
    server_name food.domelier.fr;

    include snippets/security-headers.conf;
    proxy_hide_header X-Content-Type-Options;

    location / {
        proxy_pass http://127.0.0.1:3310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    ssl_certificate /etc/letsencrypt/live/domelier.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/domelier.fr/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    server_name food.domelier.fr;
    return 301 https://food.domelier.fr$request_uri;
}
